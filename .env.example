# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/tata1mg?schema=public"

# Required. Used to sign/verify session JWTs (lib/auth.ts, middleware.ts).
# The app will refuse to start without this set — generate a long random
# value, e.g. `openssl rand -base64 48`. Never reuse this example value.
JWT_SECRET="replace-with-a-random-secret"

# Google Sign-In (Sign in / Sign up with Google).
# Create these at https://console.cloud.google.com/apis/credentials
# (OAuth client type: "Web application").
# GOOGLE_REDIRECT_URI must exactly match an "Authorized redirect URI" on that
# client — e.g. http://localhost:3000/api/auth/google/callback for local dev,
# https://yourdomain.com/api/auth/google/callback in production.
GOOGLE_CLIENT_ID="replace-with-your-google-client-id"
GOOGLE_CLIENT_SECRET="replace-with-your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"
